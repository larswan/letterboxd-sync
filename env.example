# Letterboxd Sync Configuration
# Copy this file to .env and fill in your values

# Required: Your Letterboxd username
LETTERBOXD_USERNAME=your_letterboxd_username

# Required: A TMDB API Key - free to create
TMDB_API_KEY=your_tmdb_api_key

# Optional: External Letterboxd scraping backend (recommended)
# Uses the hosted letterboxd-list-radarr service instead of direct HTML scraping.
LETTERBOXD_SCRAPER_BACKEND=external
LETTERBOXD_LIST_RADARR_BASE_URL=https://letterboxd-list-radarr.onrender.com
# Optional:
# LETTERBOXD_LIST_RADARR_LIMIT=
# LETTERBOXD_LIST_RADARR_ERROR_ON_EMPTY=true
# LETTERBOXD_EXTERNAL_SCRAPER_STRICT=0

# Optional: Plex configuration
# Get your Plex token from: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token
PLEX_HOST=http://your_plex_server

# Optional: Radarr configuration
# Get your API key from Settings > General in the Radarr Web UI
RADARR_TOKEN=your_radarr_api_key
RADARR_HOST=http://your_radarr_instance

# Optional: Overseerr configuration
OVERSEERR_API_KEY=your_overseerr_api_key
OVERSEERR_HOST=http://your_overseerr_instance